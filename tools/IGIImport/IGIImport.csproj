    <Reference Include="OpenIGI.Formats"><HintPath>$(IgiSource)/tools/OpenIGI.Tools.ResExtract/bin/Release/net10.0/OpenIGI.Formats.dll</HintPath></Reference>
    <Reference Include="OpenIGI.Scripting"><HintPath>$(IgiSource)/src/Core/OpenIGI.Scripting/bin/Release/net10.0/OpenIGI.Scripting.dll</HintPath></Reference>
  </ItemGroup>
</Project>
